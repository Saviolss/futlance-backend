generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String    @id @default(uuid())
  googleId          String?   @unique
  nome              String
  email             String    @unique
  emailVerificado   Boolean   @default(false)
  senhaHash         String?
  aceitouPolitica   Boolean   @default(false)
  aceitouPoliticaEm DateTime?
  ativo             Boolean   @default(true)
  timeId            Int?
  whatsapp          String?
  idioma            String    @default("pt")
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  codigosVerificacao CodigoVerificacao[]
  time               Time?     @relation(fields: [timeId], references: [timeId], onDelete: SetNull)
  assinaturas        Assinatura[]
}

model Assinatura {
  id                 String    @id @default(uuid())
  usuarioId          String
  timeId             Int?
  whatsapp           String
  idioma             String
  formaPagamento     String
  plano              String
  status             String    @default("PENDENTE")
  inicioEm           DateTime?
  fimEm              DateTime?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  time               Time?     @relation(fields: [timeId], references: [timeId], onDelete: SetNull)

  @@index([usuarioId])
  @@index([timeId])
  @@index([status])
}

model Time {
  id                 Int       @id @default(autoincrement())
  timeId             Int       @unique
  nome               String
  nomePopular        String
  sigla              String?
  escudo             String?
  slug               String    @unique
  tecnicoNome        String?
  tecnicoPais        String?
  idadeMedia         Float?
  alturaMedia        Float?
  camisa10           String?
  jogadoresNoPais    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  usuarios           Usuario[]
  assinaturas       Assinatura[]
}

model Elenco {
  id               Int      @id @default(autoincrement())

  timeId           Int

  numeroCamisa     Int?
  nome             String
  nomeCompleto     String?

  posicao          String?
  clube            String?

  alturaCm         Int?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Partida {
  id            Int      @id @default(autoincrement())

  partidaId     Int
  timeId        Int

  campeonato    String?
  status        String?

  data          String?
  hora          String?

  mandante      String?
  visitante     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([partidaId, timeId])
}

model Agenda {
  id               Int      @id @default(autoincrement())

  partida_id       Int      @unique

  campeonato_id    Int
  campeonato       String

  mandante_nome    String
  mandante_escudo  String?

  visitante_nome   String
  visitante_escudo String?

  data             String
  hora             String
  status           String

  data_iso         DateTime

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campeonato_id])
  @@index([data_iso])
}

model PartidaAoVivo {
  id                Int      @id @default(autoincrement())

  partida_id        Int      @unique

  campeonato_id     Int?
  campeonato_nome   String?

  status            String
  tempo             Int?

  placar_mandante   Int?
  placar_visitante  Int?

  penalti_mandante  Int?
  penalti_visitante Int?
  penalti_cobrancas Json?

  mandante_nome     String?
  mandante_escudo   String?

  visitante_nome    String?
  visitante_escudo  String?

  estadio_nome      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([campeonato_id])
  @@index([status])
}

model Artilheiro {

  id               Int      @id @default(autoincrement())

  jogador_id       Int      

  campeonato_id    Int

  nome             String

  clube_nome       String

  clube_escudo     String?

  gols             Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campeonato_id])
  @@unique([campeonato_id, jogador_id])
  @@index([gols])

}

model Tabela {

  id              Int      @id @default(autoincrement())

  campeonato_id   Int

  time_id         Int

  nome            String

  escudo          String?

  posicao         Int

  pontos          Int

  jogos           Int

  vitorias        Int

  empates         Int

  derrotas        Int

  gols_pro        Int

  gols_contra     Int

  saldo_gols      Int

  aproveitamento  Float?

  grupo           String?

  fase            String?

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  @@unique([campeonato_id, time_id])

  @@index([campeonato_id])

  @@index([grupo])

  @@index([fase])

}

model PartidaFinalizada {
  id                 Int      @id @default(autoincrement())

  partida_id         Int      @unique

  campeonato_id      Int
  campeonato_nome    String

  status             String

  mandante_nome      String
  mandante_escudo    String?

  visitante_nome     String
  visitante_escudo   String?

  placar_mandante    Int?
  placar_visitante   Int?

  data               String?
  hora               String?

  data_iso           DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([campeonato_id])
  @@index([data_iso])
}

model Noticia {
  id         Int      @id @default(autoincrement())

  titulo     String
  descricao  String?

  imagem     String?

  fonte      String

  url         String   @unique

  data        DateTime?

  categoria   String[]

  autor       String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([data])
}

model CodigoVerificacao {
  id          String      @id @default(uuid())
  usuarioId   String
  codigoHash  String
  tipo        String
  expiracao   DateTime
  usado       Boolean  @default(false)
  tentativas  Int      @default(0)
  criadoEm    DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  @@index([usuarioId])
  @@index([tipo])
  @@index([expiracao])
}